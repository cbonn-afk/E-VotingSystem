# Normalize line endings across Windows/macOS/Linux to avoid CRLF/LF churn
# and tooling inconsistencies in CI and builds.
* text=auto eol=lf

# Explicitly treat common text/source files as LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.md    text eol=lf
*.php   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env   text eol=lf

# Keep binary assets untouched
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
